# Copy to `.env` and fill in. Never commit `.env`.

# --- Shared SEED CL identity (Supabase Auth) ---
# Same salesreport project as the hub, Sales and GM dashboards: one sign-in.
# Access to THIS dashboard = "warehouse" in app.staff.departments (or is_admin).
# Values: Supabase Studio -> salesreport -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://fgqiwitiqwftvfhkchpt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Database ---
# The salesreport project, schema `warehouse`. Note ?schema=warehouse on both.
# URL-encode special chars in the password ($ -> %24, @ -> %40, etc.).
DATABASE_URL=
DIRECT_URL=

# --- Outgoing email (Outward PO to HQ, test sends) ---
# Any SMTP provider. Port 465 = SSL, 587 = STARTTLS. For Google Workspace /
# Gmail use smtp.gmail.com with an App Password, not the account password.
# Without these the Email settings page still saves; only sending is disabled.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="SEED CONTACT LENS(M) <orders@example.com>"
